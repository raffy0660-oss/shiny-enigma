# Salin file ini jadi .env lalu isi:  cp .env.example .env

# Nomor WhatsApp yang dipakai bot (kode negara, tanpa + atau spasi)
PHONE_NUMBER=6281234567890

# API key ElevenLabs untuk suara AI (daftar gratis di elevenlabs.io ➜ Profile ➜ API Keys)
ELEVENLABS_API_KEY=

# Opsional: ganti suara AI (lihat Voice Library di elevenlabs.io)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Opsional: awalan perintah dan info stiker
PREFIX=.
STICKER_PACK=Stiker Bersuara
STICKER_AUTHOR=Bot Irav
